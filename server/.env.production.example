# Example only. Keep real values in Render or an ignored .env.production.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT automatically; do not override it there.
PORT=10000
TRUST_PROXY_HOPS=1
DATABASE_POOL_MAX=5
FRONTEND_ORIGINS=https://your-toki-project.vercel.app
# Supabase Connect > Session pooler, port 5432 (not transaction mode 6543).
# URL-encode the database password. Use the actual host from the dashboard.
# Render: upload the Supabase root certificate as a Secret File named supabase-ca.crt.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
# Generate a unique secret with: openssl rand -hex 48
JWT_SECRET=
