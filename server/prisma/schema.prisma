generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  email           String           @unique @db.VarChar(254)
  passwordHash    String
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  currency        String           @default("USD") @db.VarChar(3)
  startingBalance Decimal          @default(0) @db.Decimal(19, 2)
  recurringRules  RecurringRule[]
  sessions        Session[]
  transactions    Transaction[]
  categories      Category[]
  budgets         Budget[]
  tasks           Task[]
  mySpacePhoto    MySpacePhoto?
  categoryBudgets CategoryBudget[]
}

model Category {
  isDefault       Boolean          @default(false)
  isArchived      Boolean          @default(false)
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  name            String           @db.VarChar(100)
  type            TransactionType
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurringRules  RecurringRule[]
  categoryBudgets CategoryBudget[]

  // Enables the composite FK enforcing category ownership AND matching type.
  @@unique([id, userId, type])
  @@unique([userId, name, type])
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  categoryId  String          @db.Uuid
  amount      Decimal         @db.Decimal(19, 2)
  type        TransactionType
  description String?         @db.VarChar(500)
  date        DateTime        @default(now()) @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)

  recurringId     String?        @db.Uuid
  occurrenceMonth DateTime?      @db.Date
  recurring       RecurringRule? @relation(fields: [recurringId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recurringId, occurrenceMonth])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([categoryId, userId, type])
}

model Budget {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  amount Decimal @db.Decimal(19, 2)
  month  Int     @db.SmallInt
  year   Int     @db.SmallInt
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  csrfToken String   @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RecurringRule {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  categoryId   String                @db.Uuid
  amount       Decimal               @db.Decimal(19, 2)
  type         TransactionType
  description  String?               @db.VarChar(500)
  day          Int                   @db.SmallInt
  nextDate     DateTime              @db.Date
  active       Boolean               @default(true)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)
  transactions Transaction[]
  occurrences  RecurringOccurrence[]

  @@unique([id, userId])
  @@index([active, nextDate])
  @@index([userId])
  @@index([categoryId, userId, type])
}

model RecurringOccurrence {
  recurringId String        @db.Uuid
  month       DateTime      @db.Date
  recurring   RecurringRule @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@id([recurringId, month])
}

model Task {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  name      String    @db.VarChar(200)
  dueDate   DateTime? @db.Date
  dueTime   String?   @db.VarChar(5)
  completed Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, createdAt])
}

model MySpacePhoto {
  userId    String   @id @db.Uuid
  data      Bytes
  width     Int
  height    Int
  version   String   @default(uuid()) @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CategoryBudget {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  categoryId String          @db.Uuid
  type       TransactionType @default(EXPENSE)
  amount     Decimal         @db.Decimal(19, 2)
  month      Int             @db.SmallInt
  year       Int             @db.SmallInt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, year, month, categoryId])
  @@index([categoryId, userId, type])
}
